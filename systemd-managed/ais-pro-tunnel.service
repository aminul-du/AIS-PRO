[Unit]
Description=AIS-PRO Cloudflare Edge Tunnel Daemon
Documentation=https://github.com/aminul-du/AIS-PRO
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcoreai
WorkingDirectory=/home/mcoreai/AIS-PRO
ExecStart=/home/mcoreai/.local/bin/cloudflared tunnel --config /home/mcoreai/AIS-PRO/systemd-managed/cloudflared/config.yml run fd5bd793-6d5f-45a3-9f7d-200009b12f25
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ais-pro-tunnel

# Sandboxing & security boundaries
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/home/mcoreai/AIS-PRO
ReadWritePaths=/tmp /home/mcoreai/.cloudflared

[Install]
WantedBy=default.target
